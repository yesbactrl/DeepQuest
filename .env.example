# Токен бота от @BotFather.
BOT_TOKEN=
# Выключить бота в Telegram: работает только веб, токен не нужен.
# BOT_ENABLED=false

# Кому бот отвечает: telegram_id через запятую.
# Если оставить пустым, бот в ответ на любое сообщение пришлёт твой id.
ALLOWED_TELEGRAM_IDS=

# Через что работает агент:
#   subscription — Claude Code по твоей подписке Pro/Max (по умолчанию, только для личного бота);
#   api — платные запросы по ключу Claude API.
# AGENT_BACKEND=subscription
# Полный путь к claude, если бот запускается не из терминала (например, через launchd).
# CLAUDE_CODE_PATH=/opt/homebrew/bin/claude

# Ключ Claude API (console.anthropic.com): нужен для AGENT_BACKEND=api
# или как запасной вариант при AGENT_API_FALLBACK=true (если у подписки кончились лимиты).
ANTHROPIC_API_KEY=
# AGENT_API_FALLBACK=false

# Модели агента. Оформление задач — Haiku; если Haiku отказывается, запрос повторяется на Opus.
# AGENT_PLAN_MODEL=claude-haiku-5-5
# AGENT_FALLBACK_MODEL=claude-opus-5-5
# AGENT_PLAN_EFFORT=medium
# Проверка отчётов — Opus.
# AGENT_VALIDATE_MODEL=claude-opus-5-5
# AGENT_VALIDATE_EFFORT=medium

# Голосовой ввод: локальный Whisper, модель ~1,5 ГБ скачается в DATA_DIR/models при первом запуске.
# VOICE_ENABLED=true
# VOICE_MODEL=large-v3-turbo
# Пусто — язык определяется сам.
# VOICE_LANGUAGE=ru

# Где лежит база. По умолчанию ~/Library/Application Support/DeepQuest
# DATA_DIR=./data

# LOG_LEVEL=INFO
