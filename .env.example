# Токен бота от @BotFather.
BOT_TOKEN=

# Кому бот отвечает: telegram_id через запятую.
# Если оставить пустым, бот в ответ на любое сообщение пришлёт твой id.
ALLOWED_TELEGRAM_IDS=

# Ключ Claude API (console.anthropic.com). Без него задачи сохраняются черновиками без оценки.
ANTHROPIC_API_KEY=

# Модели агента. Оформление задач — Haiku; если Haiku отказывается, запрос повторяется на Opus.
# AGENT_PLAN_MODEL=claude-haiku-5-5
# AGENT_FALLBACK_MODEL=claude-opus-5-5
# AGENT_PLAN_EFFORT=medium
# Проверка отчётов — Opus.
# AGENT_VALIDATE_MODEL=claude-opus-5-5
# AGENT_VALIDATE_EFFORT=medium

# Где лежит база. По умолчанию ~/Library/Application Support/DeepQuest
# DATA_DIR=./data

# LOG_LEVEL=INFO
